# GitHub Token - Get from https://github.com/settings/tokens
# Required scopes: repo, delete_repo, user
GITHUB_TOKEN=your_github_token_here

# Gitee Token (Optional) - Get from https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=your_gitee_token_here

# Stats Service URLs (Optional) - Use your own deployed services
# STATS_URL=https://github-readme-stats.vercel.app
# STREAK_URL=https://github-readme-streak-stats.herokuapp.com
# TROPHIES_URL=https://github-profile-trophy.vercel.app
